# Stripe (required for live checkout via /api/checkout)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Checkout product id: book. One system (book + workbook + Time Log) at $9.99.
# STRIPE_PRICE_BOOK is the live one-time price. Checkout does not read STRIPE_PRICE_RUNG2.
STRIPE_PRICE_BOOK=price_1UMYUhPj4KYXkIe0TGmkKkU7

# Public site URL (no trailing slash) — used for Checkout success/cancel redirects
# Local: http://localhost:3000
# Production: https://invocationinc.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: newsletter signup webhook (POST JSON { email, source, ts })
# If unset, /api/subscribe validates + logs email and still returns 200.
NEWSLETTER_WEBHOOK_URL=
