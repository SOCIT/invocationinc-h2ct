# Stripe (required for live checkout via /api/checkout)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs — create one-time prices in Dashboard, then paste IDs here.
# Do NOT hardcode Price IDs in source. Checkout product ids: book | stack only.
# book = $9.99 (999¢)  ·  stack = $47 (4700¢), list $97
STRIPE_PRICE_BOOK=price_...
STRIPE_PRICE_STACK=price_...

# Public site URL (no trailing slash) — used for Checkout success/cancel redirects
# Local: http://localhost:3000
# Production: https://invocationinc.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: newsletter signup webhook (POST JSON { email, source, ts })
# If unset, /api/subscribe validates + logs email and still returns 200.
NEWSLETTER_WEBHOOK_URL=
