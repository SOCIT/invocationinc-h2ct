# Stripe (required for live checkout via /api/checkout)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price ID — create a one-time price at 999 cents, then paste the ID here.
# Do NOT hardcode Price IDs in source. Checkout product id: book.
# book = the system (book + workbook + Time Log) at $9.99 via STRIPE_PRICE_BOOK.
# Use the active 999-cent price. The old 4700-cent price is inactive. Checkout does not read it.
# STRIPE_PRICE_RUNG2 is leftover from the removed price ladder. Checkout does not read it.
STRIPE_PRICE_BOOK=price_...

# Public site URL (no trailing slash) — used for Checkout success/cancel redirects
# Local: http://localhost:3000
# Production: https://invocationinc.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: newsletter signup webhook (POST JSON { email, source, ts })
# If unset, /api/subscribe validates + logs email and still returns 200.
NEWSLETTER_WEBHOOK_URL=
